# Server-side secret: set in Vercel Project Settings > Environment Variables.
OPENAI_API_KEY=
# Optional model override (default: gpt-5.5)
OPENAI_MODEL=gpt-5.5
# Optional: public URL of the deployed API, used by the Android app build.
# Leave blank for same-origin web deployment.
VITE_API_BASE_URL=
# Optional extra allowed app origin for CORS, e.g. https://your-domain.example
APP_ORIGIN=
